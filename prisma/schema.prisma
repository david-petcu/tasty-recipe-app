generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model chef_profiles {
  id               BigInt  @id @default(autoincrement())
  chef_id          BigInt  @unique
  bio              String?
  profile_image    String?
  location         String?
  years_experience Int     @default(0)
  chefs            chefs   @relation(fields: [chef_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chefs {
  id               BigInt             @id @default(autoincrement())
  username         String             @unique
  email            String             @unique
  password         String
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  chef_profiles    chef_profiles?
  recipes          recipes[]
  recipe_favorites recipe_favorites[]
  recipe_reviews   recipe_reviews[]
}

model ingredients {
  id                 BigInt               @id @default(autoincrement())
  name               String               @unique
  unit               String               @default("pcs")
  recipe_ingredients recipe_ingredients[]
}

model recipe_ingredients {
  id            BigInt      @id @default(autoincrement())
  recipe_id     BigInt
  ingredient_id BigInt
  quantity      String
  ingredients   ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes       recipes     @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([recipe_id, ingredient_id])
  @@index([ingredient_id])
}

model recipes {
  id                 BigInt               @id @default(autoincrement())
  chef_id            BigInt
  title              String
  description        String?
  image              String?
  instructions       String
  cooking_time       Int
  difficulty         String               @default("medium")
  category           String               @default("dinner")
  servings           Int                  @default(1)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  recipe_ingredients recipe_ingredients[]
  chefs              chefs                @relation(fields: [chef_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe_favorites   recipe_favorites[]
  recipe_reviews     recipe_reviews[]

  @@index([chef_id])
  @@index([category])
  @@index([created_at])
}

model recipe_reviews {
  id         BigInt   @id @default(autoincrement())
  chef_id    BigInt
  recipe_id  BigInt
  rating     Int
  comment    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  chefs      chefs    @relation(fields: [chef_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes    recipes  @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([chef_id, recipe_id])
  @@index([recipe_id, created_at])
  @@index([chef_id])
}

model recipe_favorites {
  id         BigInt   @id @default(autoincrement())
  chef_id    BigInt
  recipe_id  BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  chefs      chefs    @relation(fields: [chef_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes    recipes  @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([chef_id, recipe_id])
  @@index([chef_id, created_at])
  @@index([recipe_id])
}
